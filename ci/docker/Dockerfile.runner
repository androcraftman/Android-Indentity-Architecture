# Build upon the Android builder image
FROM android-builder:latest

USER root

# Install dependencies required by GitHub Actions Runner
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    libicu-dev \
    libkrb5-3 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Create runner user with passwordless sudo
RUN useradd -m -s /bin/bash runner && \
    usermod -aG sudo runner && \
    echo "%sudo ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

ENV RUNNER_VERSION=2.321.0

WORKDIR /home/runner

# Download GitHub Actions runner
RUN curl -o actions-runner-linux.tar.gz -L \
    "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz" && \
    tar xzf ./actions-runner-linux.tar.gz && \
    rm actions-runner-linux.tar.gz

# Set permissions
RUN chown -R runner:runner /home/runner /opt/android-sdk

COPY entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh && chown runner:runner ./entrypoint.sh

USER runner

ENTRYPOINT ["./entrypoint.sh"]
